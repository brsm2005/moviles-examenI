{
  "expo": {
    "name": "ExamenI",
    "slug": "ExamenI",
    "version": "1.0.1",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "exameni",
    "userInterfaceStyle": "light",
    "ios": {
      "icon": "./assets/expo.icon"
    },
    "android": {
      "package": "com.esfot.exameni",
      "googleServicesFile": "./google-services.json",
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.ACCESS_COARSE_LOCATION"
      ],
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#1B365D",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 76
        }
      ],
      "expo-sqlite",
      "expo-secure-store",
      [
        "expo-camera",
        {
          "cameraPermission": "ExamenI necesita acceso a la cámara para fotografiar las actas electorales."
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "ExamenI registra las coordenadas GPS del lugar donde se toma el acta."
        }
      ],
      "./node_modules/@react-native-firebase/app/plugin/build",
      "./node_modules/@react-native-firebase/crashlytics/plugin/build"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}